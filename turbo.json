{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env":["NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "NEXT_PUBLIC_BACKEND_URL",
        "NEXT_PUBLIC_GRAPH_URL", 
        "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID"
      ],
      "outputs": ["dist/**", ".next/**", "artifacts/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {}
  }
}