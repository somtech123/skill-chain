{
  "name": "@my-app/contract",
  "version": "0.0.1",
  "scripts": {
    "build": "forge build && node script/export-abi.js",
    "test": "forge test -vvv",
    "lint": "forge fmt --check",
    "deploy:local": "forge script script/Deploy.s.sol --rpc-url http://localhost:8545 --broadcast --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 && node script/write-address.js 31337",
    "deploy:sepolia": "forge script script/Deploy.s.sol --rpc-url $SEPOLIA_RPC_URL --private-key $PRIVATE_KEY --broadcast --verify --etherscan-api-key $ETHERSCAN_API_KEY && node script/write-address.js 11155111",
    "deploy:base": "forge script script/Deploy.s.sol --rpc-url $BASE_RPC_URL --broadcast --verify && node script/write-address.js 8453",
    "deploy:arbitrum": "forge script script/Deploy.s.sol --rpc-url $ARBITRUM_RPC_URL --broadcast --verify && node script/write-address.js 42161"
  }
}